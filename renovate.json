{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "group:allNonMajor"
  ],
  "timezone": "Europe/Berlin",
  "schedule": [
    "* 0-5 * * 1"
  ],
  "minimumReleaseAge": "7 days",
  "platformAutomerge": false,
  "automergeType": "pr",
  "labels": [
    "dependencies"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "packageRules": [
    {
      "description": "Kleine Updates nach bestandener CI automatisch übernehmen",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest",
        "lockFileMaintenance"
      ],
      "automerge": true
    },
    {
      "description": "Große Updates (z.B. React 19, Tailwind 4, Vite) nie automatisch",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "labels": [
        "dependencies",
        "major-update"
      ]
    },
    {
      "description": "Digest-Pins und -Updates (neu gebautes Image, gleiche Version): ohne Wartezeit, automatisch nach grüner CI",
      "matchUpdateTypes": [
        "pin",
        "pinDigest",
        "digest"
      ],
      "minimumReleaseAge": null,
      "automerge": true
    },
    {
      "description": "Sicherheits-Updates zuletzt, damit sie alle anderen Regeln überstimmen: sofort, ohne Wartezeit, automatisch nach grüner CI, auch große Sprünge",
      "matchJsonata": [
        "isVulnerabilityAlert = true"
      ],
      "schedule": [
        "at any time"
      ],
      "minimumReleaseAge": null,
      "automerge": true,
      "labels": [
        "dependencies",
        "security"
      ]
    }
  ],
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": [
      "security"
    ],
    "automerge": true,
    "schedule": [
      "at any time"
    ],
    "minimumReleaseAge": null
  },
  "dependencyDashboardOSVVulnerabilitySummary": "unresolved"
}
